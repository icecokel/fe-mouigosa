{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "fe-mouigosa 카테고리 문제은행",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "category",
    "questions"
  ],
  "properties": {
    "category": {
      "enum": [
        "JavaScript",
        "TypeScript",
        "React",
        "Browser",
        "CSS",
        "Web Performance",
        "Design Pattern"
      ]
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "question.schema.json"
      }
    }
  }
}
