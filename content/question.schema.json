{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "fe-mouigosa 문항",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "type",
    "points",
    "prompt",
    "options",
    "answer",
    "explanation",
    "sources"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "description": "문제은행 전체에서 유일한 문항 ID. 시험지 번호와 별개이며 등록 후 유지합니다."
    },
    "type": {
      "enum": [
        "개념 판단",
        "결과 예측",
        "타입 분석",
        "버그 찾기",
        "렌더링 횟수 예측",
        "브라우저 동작"
      ]
    },
    "points": {
      "type": "integer",
      "enum": [
        2,
        3,
        4,
        5
      ]
    },
    "prompt": {
      "$ref": "#/definitions/text",
      "description": "지문과 실행 환경·전제조건"
    },
    "code": {
      "$ref": "#/definitions/text",
      "description": "선택 사항. 줄바꿈은 JSON의 \\n으로 표기합니다."
    },
    "options": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/text"
      },
      "description": "①~⑤ 순서의 선택지. 원문에는 번호 기호를 넣지 않습니다."
    },
    "answer": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5,
      "description": "정답 선택지 번호 (1부터 시작)"
    },
    "explanation": {
      "$ref": "#/definitions/text",
      "description": "정답이 되는 이유와 주요 오답의 차이. 시험 종료 후 해답지에 표시합니다."
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "url"
        ],
        "properties": {
          "title": {
            "$ref": "#/definitions/text"
          },
          "url": {
            "type": "string",
            "pattern": "^https://[^\\s]+$"
          }
        }
      },
      "description": "해설의 근거가 되는 공식 문서·표준·원저자 자료. 구체적인 절이나 API로 연결하는 HTTPS 링크."
    }
  },
  "definitions": {
    "text": {
      "type": "string",
      "pattern": "\\S"
    }
  },
  "if": {
    "properties": {
      "type": {
        "enum": [
          "결과 예측",
          "타입 분석",
          "버그 찾기",
          "렌더링 횟수 예측"
        ]
      }
    }
  },
  "then": {
    "required": [
      "code"
    ]
  }
}
